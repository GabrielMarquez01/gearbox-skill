{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gearbox/schema/capsule-1.0.json",
  "title": "Gearbox telemetry capsule 1.0",
  "description": "Cápsula de telemetría de Gearbox. Sólo enums y bandas. Prohibido cualquier texto libre, identificador, ruta, URL o marca de tiempo fina. La validación normativa la ejecuta collector/schema/__init__.py; este documento es la publicación legible del contrato.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "client_version", "capsule_id", "generated_period", "contribution_mode", "events", "aggregate"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "client_version": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?(-[A-Za-z0-9.]+)?$" },
    "capsule_id": { "type": "string", "format": "uuid" },
    "generated_period": {
      "type": "string",
      "pattern": "^\\d{4}-W\\d{2}$|^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Semana ISO o fecha. Nunca hora exacta."
    },
    "contribution_mode": { "enum": ["community", "self-hosted"] },
    "events": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_type": { "enum": ["routine", "content", "implementation", "debugging", "planning", "deep_analysis", "architecture", "critical", "research", "unknown"] },
          "predicted_gear": { "enum": ["G0", "G1", "G2", "G3", "G3.5", "G4", "G5"] },
          "model_family": { "enum": ["haiku", "sonnet", "opus", "opusplan", "fable", "other"] },
          "effort": { "enum": ["low", "medium", "high", "xhigh", "unknown"] },
          "risk_band": { "enum": ["low", "medium", "high"] },
          "complexity_band": { "enum": ["low", "medium", "high"] },
          "ambiguity_band": { "enum": ["low", "medium", "high"] },
          "routing_confidence_band": { "type": "string", "pattern": "^(unknown|\\d+(\\.\\d+)?-\\d+(\\.\\d+)?|\\d+\\+)$" },
          "predicted_success_band": { "type": "string", "pattern": "^(unknown|\\d+(\\.\\d+)?-\\d+(\\.\\d+)?|\\d+\\+)$" },
          "outcome": { "enum": ["accepted", "rejected", "rework", "unknown"] },
          "rework": { "type": "boolean" },
          "cost_band": { "type": "string", "pattern": "^(unknown|\\d+(\\.\\d+)?-\\d+(\\.\\d+)?|\\d+\\+)$" },
          "latency_band": { "type": "string", "pattern": "^(unknown|\\d+(\\.\\d+)?-\\d+(\\.\\d+)?|\\d+\\+)$" },
          "human_override": { "type": "boolean" },
          "feedback_reason": { "enum": ["wrong_gear", "wrong_model", "insufficient_depth", "excessive_cost", "incorrect_result", "missing_source", "unnecessary_escalation", "needed_human_review", "none"] },
          "rating_band": { "type": "string", "pattern": "^(unknown|\\d+-\\d+)$" }
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_count"],
      "properties": { "event_count": { "type": "integer", "minimum": 0 } }
    }
  },
  "x-forbidden-fields": [
    "prompt", "prompt_hash", "response", "task_id", "session_id", "project_id",
    "cwd", "repo", "branch", "commit", "filename", "path", "url", "ip", "email",
    "phone", "hostname", "username", "token", "secret", "api_key", "reason",
    "feedback", "stack_trace", "matched_signals", "created_at", "timestamp",
    "geo", "country", "region"
  ],
  "x-transport": {
    "contributor_id": "Viaja en la cabecera X-Gearbox-Contributor, nunca en el cuerpo.",
    "content_encoding": "gzip",
    "idempotency": "Cabecera Idempotency-Key = capsule_id"
  }
}
